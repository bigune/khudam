# Community signal collection (contribution pipeline, Phase A1).
#
# Leave these unset for local development: the converter then hides its
# reporting affordances and behaves exactly as it did before the pipeline
# existed. Set them only where signals should actually be collected.
#
# Both are public by design — the anon role may insert into `signals` and
# nothing else (see supabase/README.md). The service_role key must never
# appear here; it belongs in GitHub Actions secrets.
#
# Next.js inlines NEXT_PUBLIC_* at build time, so changing these requires a
# redeploy, not just a restart.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
